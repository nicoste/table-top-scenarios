# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Campaign and save state is TRACKED, deliberately.
#
# It was ignored at first, reasoning that a store written on every brush stroke
# would churn the diff. That weighed the wrong things: hours of hand-built world
# are irreplaceable, and a noisy diff is not. With it ignored, a single stray
# `rm -rf data` destroyed two campaigns with nothing to restore from — which is
# exactly what happened (D-134).
#
# Only the trash is ignored, since the app already moves deletions aside.
data/**/.trash-*

# Local tool state
.claude/settings.local.json
coverage/
*.log

# Secrets, if any ever appear
.env
.env.*
!.env.example

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
